    <body>
      <div xml:id="szduep-000238"><!-- t1-l1prae -->
        <head xml:id="szduep-000238-Hd1e101">Praeambulum</head>
        <p xml:id="szduep-000238-d1e103">
          <pb ed="#P" n="1"/>
          <!-- 1 -->
          <cb ed="#P" n="a"/>
          <lb ed="#P" n="1"/>LIBER PRIMUS.
          <lb ed="#P" n="2"/>DE EXTSTENTIA DEI
          <lb ed="#P" n="3"/>DE ESSENTIA EJUSQUE ATTRIBUTIS IN COMMUNI.
        </p>
        <p xml:id="szduep-000238-d1e119">
          <cb ed="#P" n="b"/>
          <lb ed="#P" n="4"/>Ad nostrum institutum accedentes, 
          praesen<lb break="no" ed="#P" n="5"/>tem tractatum tribus libris comprehendemus.
          <lb ed="#P" n="6"/>In primo de Dei existentia et essentia dicemus,
          <lb ed="#P" n="7"/>ac subinde generalem de attributis divinis 
          doc<lb break="no" ed="#P" n="8"/>trinam trademus. In secundo de negativis 
          at<lb break="no" ed="#P" n="9"/>tributis dicemus, inter quae unum est, esse
          <lb ed="#P" n="10"/>incomprehensibilem et invisibilem, cujus 
          oc<lb break="no" ed="#P" n="11"/>casione de visione beatifica dicemus. In libro
          <lb ed="#P" n="12"/>autem tertio, affirmativa seu positiva attributa
          <lb ed="#P" n="13"/>explicabimus. In hoc autem primo libro prius
          <lb ed="#P" n="14"/>de existentia Dei tractabimus, quoniam hoc est
          <lb ed="#P" n="15"/>perfectionum omnium fundamentum; postea
          <lb ed="#P" n="16"/>quid sit Deus, nostro rudi modo concipiendi
          <lb ed="#P" n="17"/>et loquendi, declarare conabimur.
        </p>
      </div>
    </body>
