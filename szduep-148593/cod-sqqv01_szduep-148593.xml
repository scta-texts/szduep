      <div xml:id="szduep-148593"><!-- t3-l3prae -->
        <head xml:id="szduep-148593-Hd1e101">Praeambulum</head>
        <p xml:id="szduep-148593-d1e103">
          <pb ed="#P" n="588"/>
          <cb ed="#P" n="a"/>
          <lb ed="#P" n="1"/>LIBER TERTIUS.
          <lb ed="#P" n="2"/>DE VERA DISTINCTIONE
          <lb ed="#P" n="3"/>TRIUM PERSONARUM, ET PRAEDICATIS, QUAE IN ILLIS MULTIPLICANTUR.
        </p>
        <p xml:id="szduep-148593-d1e116">
          <cb ed="#P" n="b"/>
          <lb ed="#P" n="4"/>Tria in praesenti libro tractanda occurrunt,
          <lb ed="#P" n="5"/>scilicet, qualis sit distinctio inter divinas 
          per<lb break="no" ed="#P" n="6"/>sonas et quae attributa, seu praedicata ratione
          <lb ed="#P" n="7"/>hujus distictionis in eisdem divinis 
          multiph<lb break="no" ed="#P" n="8"/>centur et quibus verbis, seu loquendi modis
          <lb ed="#P" n="9"/>ad hanc distinctionem declarandam uti 
          possi<lb break="no" ed="#P" n="10"/>mus. Quartum vero, quod hic principahter 
          de<lb break="no" ed="#P" n="11"/>siderari peterat, scilicet, per quid 
          distiuguan<lb break="no" ed="#P" n="12"/>tur divinae personae, quia supponit earum 
          con<lb break="no" ed="#P" n="13"/>stitutionem, in libro septimo dicetur melius.
        </p>
      </div>
    </body>
