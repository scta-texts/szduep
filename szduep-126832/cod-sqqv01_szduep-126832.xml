    <body>
      <div xml:id="szduep-126832"><!-- t2-l5prae -->
        <head xml:id="szduep-126832-Hd1e101">Praeambulum</head>
        <p xml:id="szduep-126832-d1e103">
          <pb ed="#P" n="500"/>
          <cb ed="#P" n="a"/>
          <lb ed="#P" n="1"/>LIBER QUINTUS.
          <lb ed="#P" n="2"/>DE REPROBATIONE.
        </p>
        <p xml:id="szduep-126832-d1e114">
          <cb ed="#P" n="b"/>
          <lb ed="#P" n="3"/>Cum reprobatio et praedestinatio suo modo
          <lb ed="#P" n="4"/>oppositae sint, et in ea oppositione reprobatio
          <lb ed="#P" n="5"/>ad praedestinationem, tanquam privatio ad 
          ha<lb break="no" ed="#P" n="6"/>bitum comparetur, ex his quae de 
          praedestina<lb break="no" ed="#P" n="7"/>tione diximus, facile erit omnia quae ad 
          repro<lb break="no" ed="#P" n="8"/>bationem pertinent, breviter expedire, quia
          <lb ed="#P" n="9"/>privatio ex habitu, et unum oppositorum per
          <lb ed="#P" n="10"/>aliud facile dignoscitur. Ideoque illa omnia,
          <lb ed="#P" n="11"/>quae de praedestinatione diximus, in hoc libro
          <lb ed="#P" n="12"/>comprehendemus. Dicemus ergo imprimis de
          <lb ed="#P" n="13"/>actibus qui ad reprobationem concurrunt, et
          <lb ed="#P" n="14"/>in quibus consistit, deinde causas et effectus
          <lb ed="#P" n="15"/>ejus declarabimus.
        </p>
      </div>
    </body>
