      <div xml:id="szduep-115870"><!-- t2-l3prae -->
        <head xml:id="szduep-115870-Hd1e101">Praeambulum</head>
        <p xml:id="szduep-115870-d1e103">
          <cb ed="#P" n="d"/>
          <lb ed="#P" n="25"/>LIBER TERTIUS.
          <lb ed="#P" n="26"/>DE PRAEDESTINATIONIS
          <lb ed="#P" n="27"/>EFFECTIBUS, EORUMQUE CONCORDIA CUM ARBITRII LIBERTATE.
        </p>
        <p xml:id="szduep-115870-d1e114">
          <cb ed="#P" n="e"/>
          <lb ed="#P" n="28"/>Post disputationem de causis, convenienti
          <lb ed="#P" n="29"/>ordine sequitur disputatio de effectibus 
          prae<lb break="no" ed="#P" n="30"/>destinationis: per quam etiam clariora fient,
          <lb ed="#P" n="31"/>quae de causis dicta sunt. Nam cognitio 
          causa<lb break="no" ed="#P" n="32"/>rum in nobis magna ex parte fit ex effectuum
          <lb ed="#P" n="33"/>cognitione. Dicemus ergo prius generatim de
          <lb ed="#P" n="34"/>effectibus, deinde sigillatim de singulis, prius
          <lb ed="#P" n="35"/>de supernaturalibus effectibus gratiae et gloriae,
          <lb ed="#P" n="36"/>postea de bonis naturae ac tandem de malis, seu
          <lb ed="#P" n="37"/>permissionibus eorum, si quo forte modo 
          pos<lb break="no" ed="#P" n="38"/>sunt ex praedestinatione provenire. Ac tandem
          <lb ed="#P" n="39"/>falsos effectus excludemus, veramque concor-
          <cb ed="#P" n="f"/>
          <lb ed="#P" n="40"/>diam praedestinationis cum libertate 
          declara<lb break="no" ed="#P" n="41"/>bimus.
        </p>
      </div>
    </body>
